# .gitignore does not apply to the Docker build context and `COPY . /app`
# copies the whole working tree, so local-only files must be excluded here too.
.git
.claude
**/CLAUDE.md
**/CLAUDE.local.md
**/AGENTS.md

# Local environments and caches would bloat the image and leak host paths
.venv*
**/__pycache__
.pytest_cache
.env
.env.*
